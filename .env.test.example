# Plantilla de .env.test.local (ese archivo NO se versiona). Copiar a .env.test.local
# y completar los secretos por canal privado. Nunca escribir contraseñas aquí.

# Web de QA (Netlify, rama develop) y API de QA (Azure, rama developer del backend)
E2E_BASE_URL=https://qaeyesschool.netlify.app
QA_API_URL=https://<Default domain de apieyeschool-q>/api/v1

# SECRETO: contraseña de las cuentas de prueba (script BE-INF-2). Entregada por canal privado.
QA_PASSWORD=

# Cuentas del seed (DS-01 y DS-03)
E2E_ADMIN_EMAIL=admin@eyesschool.edu.co
E2E_DOCENTE_EMAIL=carlos.jimenez@eyes.edu.co
E2E_ESTUDIANTE_EMAIL=sofia.rodriguez@student.eyes.co
E2E_PADRE_UN_HIJO_EMAIL=roberto.diaz@gmail.com
E2E_PADRE_DOS_HIJOS_EMAIL=rosa.perez@gmail.com

# Hijos del padre con dos hijos (coincidencia parcial: basta el primer nombre)
E2E_HIJO_1_NOMBRE=Sofía
E2E_HIJO_2_NOMBRE=Santiago

# Registro masivo (curso 1 con 10 estudiantes sintéticos SYN0101–SYN0110)
E2E_JORNADA_MASIVO=Mañana
E2E_CURSO_MASIVO=Sexto A

# Registro de padre: estudiante SYN0101 (documento 900000001). Consultar en QA con
# GET /estudiantes como admin y copiar su id y su nombre.
E2E_ESTUDIANTE_VINCULADO_ID=
E2E_ESTUDIANTE_VINCULADO_NOMBRE=

# CP-SIS-065 a escala: solo si la web de QA se desplegó con SESSION_IDLE_MINUTES=1
E2E_SESSION_IDLE_MINUTES=

# Interruptores para los escenarios que dependen del backend (déjalos vacíos hasta que
# la corrección esté desplegada en QA; mientras tanto el escenario corre como «falla esperada»).
E2E_BE07=
E2E_BE08=

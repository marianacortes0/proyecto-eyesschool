# Plantilla de .env.local / variables del entorno de despliegue (ese archivo NO se
# versiona). Aquí solo van nombres y valores de ejemplo: ninguna contraseña, token
# ni URL con credenciales.

# API del backend, con /api/v1 al final. En QA y en producción se configura en el
# panel del proveedor (Netlify / Vercel), nunca en el repositorio.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Minutos de inactividad antes de cerrar la sesión (src/lib/auth/cookies.ts).
# Producción: 30. En QA se baja a 1 para poder probar CP-SIS-065.
SESSION_IDLE_MINUTES=30

# SECRETO: clave de Resend para /api/send-email. Se deja vacía aquí.
RESEND_API_KEY=
